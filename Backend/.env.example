# Variables de entorno del backend (Costos 3D).
# Copia este archivo como .env y completa tus datos. .env no se sube a git.
# Spring Boot lo lee al arrancar desde la carpeta Backend.

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=costos3d
DB_USERNAME=root
DB_PASSWORD=ESCRIBE_AQUI_TU_CONTRASEÑA

# ---- Servidor ----
# Si lo cambias, cambia también Frontend/proxy.conf.json
SERVER_PORT=8081

# ---- Frontend permitido (CORS) ----
# Solo hace falta al publicar el frontend en otro dominio. Varios: separados por coma.
CORS_ORIGENES=http://localhost:4200

# ---- Copias de seguridad de MySQL ----
# Ruta de mysqldump (viene con MySQL Server). Las copias quedan en Backend/respaldos.
RESPALDO_MYSQLDUMP=C:/Program Files/MySQL/MySQL Server 8.4/bin/mysqldump.exe
# Cuántas copias guardar (las más viejas se borran) y a qué hora hacer la diaria.
RESPALDO_CONSERVAR=30
RESPALDO_CRON=0 0 21 * * *
